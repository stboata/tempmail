{
  "name": "temporary-mail",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "entities": "9.0.0",
    "postal-mime": "4.2.1"
  },
  "devDependencies": {
    "wrangler": "4.162.0"
  },
  "cloudflare": {
    "bindings": {
      "MAIL_DOMAIN": {
        "description": "接收临时邮件的域名，例如 example.com。域名须已接入你自己的 Cloudflare 账号。"
      },
      "ACCESS_KEY": {
        "description": "自定义访问密钥，使用不含空格的英文字母、数字或符号。保存为 Cloudflare Secret，不要提交到 GitHub。"
      },
      "DB": {
        "description": "保存 24 小时内的邮件及正文图片，部署时自动创建。"
      }
    }
  }
}
